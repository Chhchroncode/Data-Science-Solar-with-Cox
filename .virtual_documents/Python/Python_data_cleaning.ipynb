import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
pd.set_option('display.max_columns', None)


repd=pd.read_csv("C:\Data Science Solar with Cox\Data\Raw\REPD_Publication_Q2_2026.csv",encoding="cp1252")


repd.shape


repd.head()


print(repd.dtypes)


print(repd["Technology Type"].unique())


print(repd["Technology Type"].value_counts())


solar=repd[repd["Technology Type"]=="Solar Photovoltaics"]


solar.shape


print(solar.duplicated().sum())


solar['Ref ID'].is_unique


print(solar.isnull().sum())


#Dropping columns with info irrelevant to solar, and reference numbers that will not be used in analysis
#Dropping columns with detailed location information, GIS is not within scope of this project
#Dropping columns with info on post-consent stages, this  project focuses on consent time
solar=solar.drop(columns=["Operator (or Applicant)","Storage Co-location REPD Ref ID","Turbine Capacity (MW)","No. of Turbines","Height of Turbines (m)","Address","Post Code","X-coordinate","Y-coordinate","Planning Application Reference","Appeal Reference","Secretary of State Reference","Offshore Wind Round","Heat Network Ref","Under Construction","Operational"])


print(solar["Mounting Type for Solar"].value_counts())


solar["Mounting Type for Solar"] = solar["Mounting Type for Solar"].str.strip()
print(solar["Mounting Type for Solar"].value_counts())


#Rooftop solar is subjected to a different consent regime in prior approval and planning timelines
#Scope of this project focuses on ground mount
solar=solar[solar["Mounting Type for Solar"]=="Ground"]
solar.shape


print(solar.isnull().sum())


#Focus on projects >=5MW, definition of large scale ground mount for DESNZ
#Smaller solar farm face faster consent time, aim to build model that generalise to larger projects in this analysis
solar["Installed Capacity (MWelec)"]=pd.to_numeric(solar["Installed Capacity (MWelec)"],errors="coerce")
solar=solar[solar["Installed Capacity (MWelec)"]>=5]
solar.shape


print(solar.isnull().sum())


print(solar.head(3).T)


print(solar.dtypes)


print(solar.notna().sum())


print(solar[["Development Status","Development Status (short)"]].value_counts())


#Remove abandoned projects with no decision date, due to unclear planning status of projects
solar=solar[solar["Development Status"]!="Abandoned"]
solar.shape


solar.columns.tolist()


print(solar[['Planning Permission Expired','Judicial Review']].value_counts())


print(solar['Type of Secretary of State Intervention'].value_counts())


date_column=['Record Last Updated (dd/mm/yyyy)','Judicial Review','Planning Application Submitted','Planning Application Withdrawn','Planning Permission Refused','Appeal Lodged','Appeal Withdrawn','Appeal Refused','Appeal Granted','Planning Permission  Granted','Secretary of State - Intervened','Secretary of State - Refusal','Secretary of State - Granted','Planning Permission Expired']
for date in date_column:
    solar[date]=pd.to_datetime(solar[date],format="%d/%m/%Y",errors="coerce")
solar.dtypes


solar["Solar Site Area (sqm)"]=pd.to_numeric(solar["Solar Site Area (sqm)"],errors="coerce")
solar.dtypes


#Dropping support scheme info. RO, FiT,CfD are schemes that can only be applied after planning permission is granted and have no material impact on planning
solar=solar.drop(columns=['RO Banding (ROC/MWh)','FiT Tariff (p/kWh)','CfD Capacity (MW)'])
solar.shape


print(solar['Type of Secretary of State Intervention'].value_counts())


solar['Type of Secretary of State Intervention'] = solar['Type of Secretary of State Intervention'].str.strip()
print(solar['Type of Secretary of State Intervention'].value_counts())


print(solar['Judicial Review'].value_counts())


solar[solar['Type of Secretary of State Intervention'].notna()]


solar['Type of Secretary of State Intervention']=solar['Type of Secretary of State Intervention'].str.strip().replace({'': pd.NA,'Call-In Application': 'Call-In','Call-in':'Call-In'})
print(solar['Type of Secretary of State Intervention'].value_counts())


print(solar['Secretary of State - Intervened'].value_counts())


solar[solar['Secretary of State - Intervened'].notna()]


print(solar['Secretary of State - Refusal'].value_counts())


print(solar['Secretary of State - Granted'].value_counts())


#Drop project that secretariat has intervened, it takes project out of the regular planning mechanism
solar=solar[solar[['Type of Secretary of State Intervention','Secretary of State - Intervened']].isna().all(axis=1)]
print(solar.notna().sum())


solar=solar.drop(columns=['Type of Secretary of State Intervention','Secretary of State - Intervened'])
solar.shape


#Dropping planning permission expired, post-consent data unrelated to consent time
solar=solar.drop(columns=['Planning Permission Expired'])


#Dropping projects missing essential information
#Not knowing key jurisdiction and lPA info damages the credibility of planning-related information
#Project needs to be submitted to be included in this Cox analysis
solar=solar[solar[['County','Region','Country','Planning Authority','Planning Application Submitted']].notna().all(axis=1)]
solar.shape


solar.columns.tolist()


catcols=['Storage Type','Share Community Scheme','CHP Enabled','CfD Allocation Round']
solar[catcols].melt(var_name='Column', value_name='Category').value_counts(dropna=False).sort_index()


#Dropping CHP enabled due to no project with CHP
#In cox, not meaningful comparing no against unknown
solar=solar.drop(columns=['CHP Enabled'])
solar.shape


solar['Share Community Scheme']=solar['Share Community Scheme'].str.strip().replace({'': pd.NA})
solar['Storage Type']=solar['Storage Type'].str.strip().replace({'': pd.NA})
catcols=['Storage Type','Share Community Scheme','CfD Allocation Round']
solar[catcols].melt(var_name='Column', value_name='Category').value_counts(dropna=False).sort_index()


#Drop share community scheme with no valid values
solar=solar.drop(columns=['Share Community Scheme'])
solar.shape


#Assigning value to null in categorical variables for cox
catcols=['Storage Type','CfD Allocation Round']
solar[catcols]=solar[catcols].fillna('No')


#Treating reapplication as separate projects, but adding binary variable that indicates application history
#For another analysis focusing on reapplication,potential improvement could be using a multi-state model
solar['Reapplying']=np.where(solar['Are they re-applying (New REPD Ref)'].isna()&solar['Are they re-applying (Old REPD Ref) '].isna(),'No','Yes').astype(str)
print(solar['Reapplying'].value_counts())


solar=solar.drop(columns=['Are they re-applying (New REPD Ref)','Are they re-applying (Old REPD Ref) '])
solar.shape


