sb.boxplot(x=solar['Installed Capacity (MWelec)'],log_scale=True)
plt.title('Boxplot for Capacity MW')
plt.xlabel('Project Size')
plt.show()


solar=solar.rename(columns={'Installed Capacity (MWelec)': 'Capacity_MW'})


zero_capacity=solar[solar['Capacity_MW']==0]
print(zero_capacity)


#Create log column of MW because of skewness in the Capacity MW column
#Ensure linear relationship with Cox hazard and prevent high leverage from a few projects
solar['log_Capacity_MW']=np.log(solar['Capacity_MW'])
print(solar['log_Capacity_MW'].describe())


#Add MW band as a way to sort skewness in MW
#MW band are set according to statutory threshold
#10MW:Welsh Threshold for bypassing local council, 50MW: Scottish Threshold for Session 36 planning act, English NSIP threshold before 2025
#100MW: English threshold for NSIP after 2025
#350MW: Welsh Threshold for NSIP, ommitted due to limited projects and events, prevent wide CI in model
#Developers commonly submit project as 9.9, 49.9 etc to maximise within threshold
solar["Capacity_band"] = np.select(
    [solar["Capacity_MW"] <= 9.99,solar["Capacity_MW"] <= 49.99,solar["Capacity_MW"] <= 99.99],
    ["5-9.99 MW", "9.99-49.99 MW","49.99-99.99 MW"], default=">99.99 MW")
print(solar["Capacity_band"].value_counts())


print(solar['Country'].value_counts())


#Projects in NI not in scope due to very different planning system and separate grid network
solar=solar[solar['Country']!='Northern Ireland']
solar.shape


#Add column for decision routes to explore combined effect of capacity and country
solar['Decision_Route']=solar['Country'].astype(str)+'_'+solar["Capacity_band"].astype(str)
print(solar['Decision_Route'].value_counts())


decision_route_name={'England_5-9.99 MW':'English_TCPA','England_9.99-49.99 MW':'English_TCPA','England_49.99-99.99 MW':'English_TCPA','England_>99.99 MW':'English_NSIP',
                    'Wales_5-9.99 MW':'Wales_local','Wales_9.99-49.99 MW':'Wales_DNS','Wales_49.99-99.99 MW':'Wales_DNS','Wales_>99.99 MW':'Wales_DNS',
                    'Scotland_5-9.99 MW':'Scotland_Local','Scotland_9.99-49.99 MW':'Scotland_Local','Scotland_49.99-99.99 MW':'Scotland_36','Scotland_>99.99 MW':'Scotland_36'}
solar['Decision_Route']=solar['Decision_Route'].map(decision_route_name)
print(solar['Decision_Route'].value_counts())


