import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


repd=pd.read_csv("C:\Data Science Solar with Cox\Data\Raw\REPD_Publication_Q2_2026.csv",encoding="cp1252")


repd.shape


repd.head()


print(repd.dtypes)


print(repd["Technology Type"].unique())


print(repd["Technology Type"].value_counts())


solar=repd[repd["Technology Type"]=="Solar Photovoltaics"]


solar.shape


print(solar.duplicated().sum())


print(solar.isnull().sum())


#Dropping columns with info irrelevant to solar, and reference numbers that will not be used in analysis
#Dropping columns with detailed location information, GIS is not within scope of this project
#Dropping columns with info on post-consent stages, this  project focuses on consent time
solar=solar.drop(columns=["Operator (or Applicant)","Storage Co-location REPD Ref ID","Turbine Capacity (MW)","No. of Turbines","Height of Turbines (m)","Address","Post Code","X-coordinate","Y-coordinate","Planning Application Reference","Appeal Reference","Secretary of State Reference","Offshore Wind Round","Heat Network Ref","Under Construction","Operational"])


print(solar["Mounting Type for Solar"].value_counts())


solar["Mounting Type for Solar"] = solar["Mounting Type for Solar"].str.strip()
print(solar["Mounting Type for Solar"].value_counts())


#Rooftop solar is subjected to a different consent regime in prior approval and planning timelines
#Scope of this project focuses on ground mount
solar=solar[solar["Mounting Type for Solar"]=="Ground"]
solar.shape


print(solar.isnull().sum())


#Focus on projects >=5MW, definition of large scale ground mount for DESNZ
#Smaller solar farm face faster consent time, aim to build model that generalise to larger projects in this analysis
solar["Installed Capacity (MWelec)"]=pd.to_numeric(solar["Installed Capacity (MWelec)"],errors="coerce")
solar=solar[solar["Installed Capacity (MWelec)"]>=5]
solar.shape


print(solar.isnull().sum())


print(solar.head(3).T)


print(solar.dtypes)


print(solar.notna().sum())


print(solar[["Development Status","Development Status (short)"]].value_counts())


#Remove abandoned projects with no decision date, due to unclear planning status of projects
solar=solar[solar["Development Status"]!="Abandoned"]
solar.shape


solar.columns.tolist()


print(solar[['Planning Permission Expired','Judicial Review']].value_counts())


print(solar[['Type of Secretary of State Intervention']].value_counts())


date_column=['Record Last Updated (dd/mm/yyyy)','Judicial Review','Planning Application Submitted','Planning Application Withdrawn','Planning Permission Refused','Appeal Lodged','Appeal Withdrawn','Appeal Refused','Appeal Granted','Planning Permission  Granted','Secretary of State - Intervened','Secretary of State - Refusal','Secretary of State - Granted','Planning Permission Expired']
for date in date_column:
    solar[date]=pd.to_datetime(solar[date],format="%d/%m/%Y",errors="coerce")
solar.dtypes


solar["Solar Site Area (sqm)"]=pd.to_numeric(solar["Solar Site Area (sqm)"],errors="coerce")


